<section class="tab hide-overflow{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="scrollable">
        <div class="form-group-stacked mb-3">
            <div class="form-group">
                <label>{{localize "SR5.Race.BaseRace"}}</label>
                <div class="form-fields">
                    {{#if @root.isEditMode}}
                        {{formInput systemFields.race value=source.system.race rootId=rootId classes="short"}}
                    {{else}}
                        <input type="text" value="{{system.race}}" class="short" disabled />
                    {{/if}}
                </div>
            </div>
            <div class="form-group">
                <label>{{localize "SR5.Label"}}</label>
                <div class="form-fields">
                    {{#if @root.isEditMode}}
                        {{formInput systemFields.label value=source.system.label rootId=rootId classes="short"}}
                    {{else}}
                        <input type="text" value="{{system.label}}" class="short" disabled />
                    {{/if}}
                </div>
            </div>
        </div>

        <div class="metavariants-header flexrow align-center justify-between mb-2">
            <h3>{{localize "SR5.Race.Metavariants"}}</h3>
            {{#if @root.isEditMode}}
                <button type="button" class="btn btn-sm" data-action="createMetavariant">
                    <i class="fa-solid fa-plus"></i> {{localize "SR5.Race.CreateMetavariant"}}
                </button>
            {{/if}}
        </div>

        <div class="metavariants-container">
            {{#each metavariantsList}}
            <div class="metavariant-panel card p-2 mb-3 border {{#if this.isActive}}active-metavariant{{/if}}">
                <div class="metavariant-panel-header flexrow align-center justify-between mb-2">
                    <div class="variant-identity">
                        <strong>{{this.label}}</strong>
                        <span class="text-xs text-muted">({{this.name}})</span>
                        {{#if this.isActive}}
                            <span class="badge badge-success">{{localize "SR5.Active"}}</span>
                        {{/if}}
                    </div>
                    <div class="variant-meta flexrow align-center gap-1">
                        <span class="badge badge-info">{{this.karma}} {{localize "SR5.Karma"}}</span>
                        {{#if @root.isEditMode}}
                            {{#unless this.isOnlyVariant}}
                                <button type="button" class="btn btn-icon btn-danger btn-sm" data-action="deleteMetavariant" data-variant-name="{{this.name}}" data-tooltip="SR5.Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            {{/unless}}
                        {{/if}}
                    </div>
                </div>

                {{#if this.attributeSummary}}
                <div class="variant-attribute-summary text-xs mb-2">
                    <strong>{{localize "SR5.Attributes"}}:</strong> {{this.attributeSummary}}
                </div>
                {{/if}}

                {{#if this.description}}
                <div class="variant-description-text text-xs mb-2 text-muted">
                    {{this.description}}
                </div>
                {{/if}}

                <div class="granted-items-section mt-2">
                    <div class="granted-group mb-2">
                        <span class="text-xs font-semibold">{{localize "SR5.ItemTypes.Quality"}} ({{this.resolvedQualities.length}}):</span>
                        <div class="granted-items-badges flexrow flex-wrap gap-1 mt-1">
                            {{#each this.resolvedQualities}}
                            <span class="badge-pill granted-badge" data-uuid="{{this.uuid}}">
                                {{#if this.img}}<img src="{{this.img}}" width="16" height="16" />{{/if}}
                                <a data-action="openGrantedItem" data-uuid="{{this.uuid}}">{{this.name}}</a>
                                {{#if @root.isEditMode}}
                                <button type="button" class="btn-clear-inline" data-action="removeGrantedUuid" data-variant-name="{{../name}}" data-category="qualities" data-uuid="{{this.uuid}}">&times;</button>
                                {{/if}}
                            </span>
                            {{else}}
                            <span class="text-xs text-muted italic">{{localize "SR5.None"}}</span>
                            {{/each}}
                        </div>
                    </div>

                    <div class="granted-group mb-2">
                        <span class="text-xs font-semibold">{{localize "SR5.ItemTypes.Weapon"}} ({{this.resolvedWeapons.length}}):</span>
                        <div class="granted-items-badges flexrow flex-wrap gap-1 mt-1">
                            {{#each this.resolvedWeapons}}
                            <span class="badge-pill granted-badge" data-uuid="{{this.uuid}}">
                                {{#if this.img}}<img src="{{this.img}}" width="16" height="16" />{{/if}}
                                <a data-action="openGrantedItem" data-uuid="{{this.uuid}}">{{this.name}}</a>
                                {{#if @root.isEditMode}}
                                <button type="button" class="btn-clear-inline" data-action="removeGrantedUuid" data-variant-name="{{../name}}" data-category="weapons" data-uuid="{{this.uuid}}">&times;</button>
                                {{/if}}
                            </span>
                            {{else}}
                            <span class="text-xs text-muted italic">{{localize "SR5.None"}}</span>
                            {{/each}}
                        </div>
                    </div>

                    <div class="granted-group mb-2">
                        <span class="text-xs font-semibold">{{localize "SR5.FOUNDRY.Item"}} ({{this.resolvedItems.length}}):</span>
                        <div class="granted-items-badges flexrow flex-wrap gap-1 mt-1">
                            {{#each this.resolvedItems}}
                            <span class="badge-pill granted-badge" data-uuid="{{this.uuid}}">
                                {{#if this.img}}<img src="{{this.img}}" width="16" height="16" />{{/if}}
                                <a data-action="openGrantedItem" data-uuid="{{this.uuid}}">{{this.name}}</a>
                                {{#if @root.isEditMode}}
                                <button type="button" class="btn-clear-inline" data-action="removeGrantedUuid" data-variant-name="{{../name}}" data-category="items" data-uuid="{{this.uuid}}">&times;</button>
                                {{/if}}
                            </span>
                            {{else}}
                            <span class="text-xs text-muted italic">{{localize "SR5.None"}}</span>
                            {{/each}}
                        </div>
                    </div>

                    {{#if @root.isEditMode}}
                    <div class="metavariant-drop-zone p-2 border-dashed text-center text-xs text-muted" data-drop-variant="{{this.name}}">
                        <i class="fa-solid fa-download"></i> {{localize "SR5.Race.DropItemHere"}}
                    </div>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>
