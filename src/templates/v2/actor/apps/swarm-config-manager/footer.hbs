<footer class="sheet-footer" style="display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px; border-top: 1px solid rgba(255, 255, 255, 0.1);">
    <div>
        {{#if hasActiveSwarm}}
            <button class="sr5-button" type="button" data-action="deleteSwarm" style="background: rgba(220, 53, 69, 0.3); border-color: #dc3545; color: #ff8787;">
                <i class="fas fa-trash"></i> {{localize "SR5.Swarm.DeleteSwarm"}}
            </button>
        {{/if}}
    </div>
    <div style="display: flex; gap: 8px;">
        <button class="sr5-button" type="button" data-action="saveSwarm">
            <i class="fas fa-save"></i> {{localize "SR5.Swarm.SaveSwarm"}}
        </button>
        {{#if canDeploy}}
            <button class="sr5-button" type="button" data-action="deploySwarm" style="background: rgba(0, 150, 255, 0.3);">
                <i class="fas fa-crosshairs"></i> {{localize "SR5.Swarm.DeploySwarm"}}
            </button>
        {{/if}}
        <button class="sr5-button" type="button" data-action="cancel">
            <i class="fas fa-ban"></i> {{localize "SR5.Swarm.Cancel"}}
        </button>
    </div>
</footer>
