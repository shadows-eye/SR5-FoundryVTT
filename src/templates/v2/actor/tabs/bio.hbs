<section class="tab hide-overflow{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{#if itemType.metatype.length}}
        <div class="metatype-banner">
            {{#each itemType.metatype}}
                <div class="metatype-banner-info" data-item-id="{{this.id}}">
                    <img src="{{this.img}}" data-action="openMetatypeSheet" data-tooltip="SR5.EditItem" />
                    <div>
                        <div class="metatype-banner-title">
                            <span>{{this.name}}</span>
                            {{#if this.system.metatype}}
                                <span class="metatype-base-type">({{localizeTypeOr this.system.metatype @root.config.metatypes}})</span>
                            {{/if}}
                        </div>
                        <div class="metatype-banner-details">
                            <span>{{localize "SR5.Subtype"}}: {{localize (concat 'SR5.MetaSubtypes.' this.system.subtype)}}</span>
                            {{#if this.system.karma}}
                                <span>{{localize "SR5.Labels.Karma"}}: {{this.system.karma}}</span>
                            {{/if}}
                        </div>
                    </div>
                </div>
                <div class="metatype-banner-actions" data-item-id="{{this.id}}">
                    <a data-action="openMetatypeSheet" data-tooltip="SR5.EditItem">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a data-action="removeMetatype" data-tooltip="SR5.Delete">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            {{/each}}
        </div>
    {{/if}}
    <div class="split-container">
        <div>
            {{> 'systems/shadowrun5e/dist/templates/v2/list-items/quality/header.hbs'
                label='SR5.ItemTypes.Quality'
                cssClass="header-for-scrollable"
                type='quality' }}
            <div class="scrollable" id="quality-scroll-list">
                {{#each itemType.quality}}
                    {{> 'systems/shadowrun5e/dist/templates/v2/list-items/quality/item.hbs' item=this }}
                {{/each}}
            </div>
        </div>
        {{#ife actor.type 'character'}}
            {{#if awakened}}
            <div>
                {{> 'systems/shadowrun5e/dist/templates/v2/list-items/metamagic/header.hbs'
                    label='SR5.Metamagics'
                    cssClass="header-for-scrollable"
                    type='metamagic' }}
                <div class="scrollable" id="metamagics-scroll-list">
                    {{#each itemType.metamagic}}
                        {{> 'systems/shadowrun5e/dist/templates/v2/list-items/metamagic/item.hbs'
                            item=this
                        }}
                    {{/each}}
                </div>
            </div>
            {{/if}}
            {{#if emerged}}
                <div>
                    {{> 'systems/shadowrun5e/dist/templates/v2/list-items/echo/header.hbs'
                        label='SR5.Echoes'
                        cssClass="header-for-scrollable"
                        type='echo' }}
                    <div class="scrollable" id="echoes-scroll-list">
                        {{#each itemType.echo}}
                            {{> 'systems/shadowrun5e/dist/templates/v2/list-items/echo/item.hbs' item=this }}
                        {{/each}}
                    </div>
                </div>
            {{/if}}
        {{/ife}}
    </div>
</section>
