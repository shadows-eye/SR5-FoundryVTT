<div class="metavariant-selection-dialog-content">
    <p class="dialog-hint">{{localize "SR5.Race.SelectMetavariantHint"}}</p>
    <div class="metavariant-list">
        {{#each variants}}
        <div class="metavariant-card">
            <label class="metavariant-header" for="variant-{{this.name}}">
                <input type="radio" id="variant-{{this.name}}" name="selectedVariant" value="{{this.name}}" {{#if this.active}}checked{{/if}}>
                <span class="variant-name"><strong>{{this.label}}</strong></span>
                <span class="variant-karma badge-pill">{{this.karma}} {{localize "SR5.Karma"}}</span>
            </label>
            {{#if this.attributeSummary}}
            <div class="variant-attributes text-xs text-muted">
                {{this.attributeSummary}}
            </div>
            {{/if}}
            {{#if this.description}}
            <div class="variant-description text-xs">
                {{this.description}}
            </div>
            {{/if}}
        </div>
        {{/each}}
    </div>
</div>
