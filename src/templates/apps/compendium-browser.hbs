<div class="sr5-compendium-browser">
  <div class="compendium-filters">
    <div class="search-bar">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="14" height="14" fill="currentColor">
        <path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"/>
      </svg>
      <input type="text" placeholder="Search by name...">
      <span class="clear-filter">&times;</span>
    </div>
  </div>

  <div class="compendium-results">
    <div class="results-header">
      <h2>Results</h2>
      <div class="header-source">SOURCE</div>
    </div>
    <div class="compendium-list" data-pack="{{pack}}">
      {{#if entries.length}}
        {{#each entries as |entry id|}}
          <div class="compendium-entry" data-uuid="{{entry.uuid}}" draggable="true">
            <div class="result-row">
              <div class="item-image">
                <img src="{{entry.img}}" alt="{{entry.name}}" loading="lazy">
              </div>
              <div class="item-details">
                <h3>{{entry.name}}</h3>
                <div class="item-type">{{entry.type}}</div>
              </div>
              <div class="item-meta">
                <span class="item-source">{{entry.system.description.source}}</span>
              </div>
            </div>
          </div>
        {{/each}}
      {{else}}
        <div class="no-results">No items found. Try adjusting your filters.</div>
      {{/if}}
    </div>
  </div>
</div>
